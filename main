    def cup_125(self):
         self.balance =  float(self.ui.label_gl_balance.text())
         self.prise = float(self.ui.pushButton_cup_125.text())
         self.s = float(self.ui.label_14.text())
         if self.balance >= self.prise:
              self.new_balance = self.balance - self.prise
              self.s += 1
              self.ui.label_gl_balance.setText(str(self.new_balance))
              self.ui.label_14.setText(str(self.s))

              self.items["125"] = True

              self.ui.pushButton_cup_125.setEnabled(False)
              self.ui.pushButton_cup_125.setStyleSheet("""
              QPushButton{
                 background-color: rgb(165, 165, 165);
                 color: rgb(255, 255, 255);
                 border-radius: 15px;
                 padding: 0px;
               }
                 QPushButton:pressed{
                 padding-top: 2px;     
                 padding-left: 2px;
                 background-color: rgb(126, 125, 126);
               }
              """)
              self.setting = QSettings("Clicer", "magaz")

              self.setting.setValue("button_color", "rgb(165, 165, 165)")
              self.setting.setValue("enabled", self.ui.pushButton_cup_125.isEnabled())

              self.setting.setValue("items", json.dumps(self.items))



                     
                     
    def cup_450(self):
             self.balance =  float(self.ui.label_gl_balance.text())
             self.prise = float(self.ui.pushButton_cup450.text())
             self.s = float(self.ui.label_14.text())
             if self.balance >= self.prise:
                  self.new_balance = self.balance - self.prise
                  self.s += 5
                  self.ui.label_gl_balance.setText(str(self.new_balance))
                  self.ui.label_14.setText(str(self.s))

                  self.items["450"] = True

                  self.ui.pushButton_cup450.setEnabled(False)
                  self.ui.pushButton_cup450.setStyleSheet("""
              QPushButton{
                 background-color: rgb(165, 165, 165);
                 color: rgb(255, 255, 255);
                 border-radius: 15px;
                 padding: 0px;
               }
                 QPushButton:pressed{
                 padding-top: 2px;     
                 padding-left: 2px;
                 background-color: rgb(126, 125, 126);
               }
                         """)
                  self.setting = QSettings("Clicer", "magaz")
                  
                  self.setting.setValue("enabled", self.ui.pushButton_cup450.isEnabled())
                  
                  self.setting.setValue("items", json.dumps(self.items))
    def cup_1250(self):
             self.balance =  float(self.ui.label_gl_balance.text())
             self.prise = float(self.ui.pushButton_cup1250.text())
             self.s = float(self.ui.label_14.text())
             if self.balance >= self.prise:
                  self.new_balance = self.balance - self.prise
                  self.s += 10
                  self.ui.label_gl_balance.setText(str(self.new_balance))
                  self.ui.label_14.setText(str(self.s))

                  self.items["1250"] = True

                  self.ui.pushButton_cup1250.setEnabled(False)
                  self.ui.pushButton_cup1250.setStyleSheet("""
