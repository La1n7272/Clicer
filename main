    def s_u(self):
           self.page = self.ui.stackedWidget.widget(1)
           self.utca = QLabel("",self.page)
           self.utca.setPixmap(QPixmap(":/images/images/pngwing.com.png"))
           self.utca.setScaledContents(True)
           self.utca.setGeometry(10,40,251,471)
           self.utca.setAttribute(Qt.WA_TransparentForMouseEvents)
           self.utca.show()

    def s_g(self):
