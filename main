    def cup_125(self):
         self.balance =  int(self.ui.label_gl_balance.text())
         self.prise = int(self.ui.pushButton_cup_125.text())
         self.s = int(self.ui.label_14.text())
         if self.balance >= self.prise:
              self.new_balance = self.balance - self.prise
              self.s += 1
              self.ui.label_gl_balance.setText(str(self.new_balance))
              self.ui.label_14.setText(str(self.s))
    def cup_450(self):
