    def open_magaz(self):
         self.ui.stackedWidget.setCurrentIndex(2)
    def open_glav(self):
         self.ui.stackedWidget.setCurrentIndex(0)
    def open_prof(self):
         self.ui.stackedWidget.setCurrentIndex(1)

    def clic(self):
         self.s = float(self.ui.label_14.text())

         self.c= float(self.ui.label_gl_balance.text())

         self.c_clic = float(self.ui.label_16.text().replace("X", ""))

         self.s *= self.c_clic

         self.n = self.s + self.c

         self.q["monet"] + self.n

         self.ui.label_gl_balance.setText(str(self.n))

         self.k = float(self.ui.label_gl_clici.text())

         self.k += 1

         self.clics = self.k

         self.ui.label_gl_clici.setText(str(self.k))

         self.do()

    def do(self):
           if self.clics >= 1:
                  self.pa = self.ui.frame_5
                  self.one_dos = QLabel("",self.pa)
                  self.one_dos.setPixmap(QPixmap(":/images/icons8.png"))
                  self.one_dos.setScaledContents(True)
                  self.one_dos.setGeometry(143,15,31,31)
                  self.one_dos.setAttribute(Qt.WA_TransparentForMouseEvents)
                  self.one_dos.show()
                  self.dos["1_clic"] = True
           if self.n >= 1000:
                  self.pa = self.ui.frame_5
                  self.two_dos = QLabel("",self.pa)
                  self.two_dos.setPixmap(QPixmap(":/images/icons8.png"))
                  self.two_dos.setScaledContents(True)
                  self.two_dos.setGeometry(153,78,31,31)
                  self.two_dos.setAttribute(Qt.WA_TransparentForMouseEvents)
                  self.two_dos.show()
                  self.dos["1000_monet"] = True
           if self.clics >= 10000:
                  self.pa = self.ui.frame_5
                  self.tree_dos = QLabel("",self.pa)
                  self.tree_dos.setPixmap(QPixmap(":/images/icons8.png"))
                  self.tree_dos.setScaledContents(True)
                  self.tree_dos.setGeometry(153,150,31,31)
                  self.tree_dos.setAttribute(Qt.WA_TransparentForMouseEvents)
                  self.tree_dos.show()
                  self.dos["10000_clic"] = True
           if self.n >= 1000000000:
                  self.pa = self.ui.frame_5
                  self.four_dos = QLabel("",self.pa)
                  self.four_dos.setPixmap(QPixmap(":/images/icons8.png"))
                  self.four_dos.setScaledContents(True)
                  self.four_dos.setGeometry(180,218,31,31)
                  self.four_dos.setAttribute(Qt.WA_TransparentForMouseEvents)
                  self.four_dos.show()
                  self.dos["1000000000_monet"] = True        

    def finish(self):
            self.q = {
                "name" : self.ui.lineEdit_im_pol.text(),
                "o sebe" : self.ui.lineEdit_o_sebe.text(),
                "monet" : 0,
                "clici" : 0,
                "za clic" : 1.0,
                "bonus" : 1.0,           
                    }
            self.ui.stackedWidget.setCurrentIndex(0)
            self.ui.label_gl_balance.setText(str(self.q["monet"]))
            self.ui.label_gl_clici.setText(str(self.q["clici"]))
            self.ui.label_14.setText(str(self.q["za clic"]))
            self.ui.label_16.setText(str(f"X{self.q["bonus"]}"))
            self.ui.label_im_pol.setText(str(self.q["name"]))
            self.ui.label_o_sebe.setText(str(self.q["o sebe"]))
            with open("dann.json","w",encoding="utf-8") as f:
                json.dump(self.q,f,ensure_ascii=False,indent=4)
               

    def closeEvent(self, event):
            self.monet = float(self.ui.label_gl_balance.text())
            self.clici = float(self.ui.label_gl_clici.text())
            self.zaclic = float(self.ui.label_14.text())
            self.bonus = float(self.ui.label_16.text().replace("X",""))

            self.q["monet"] = self.monet
            self.q["clici"] = self.clici
            self.q["za clic"] = self.zaclic
            self.q["bonus"] = self.bonus

            with open("dann.json","w",encoding="utf-8") as f:
                json.dump(self.q,f,ensure_ascii=False,indent=4)


            with open("dosti.json","w",encoding="utf-8") as w:
                   json.dump(self.dos,w,ensure_ascii=False,indent=4)

            self.setting.setValue("items", json.dumps(self.items))

            event.accept

if __name__ == "__main__":
    app = QApplication([])
    window = MainWindow()
    window.show()
    sys.exit(app.exec())

